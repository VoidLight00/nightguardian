#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# NightGuardian CLI v1.0
# Usage: nightguardian [command] [options]
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

CONFIG_DIR="${HOME}/.forgechain-nightguardian"
BIN_DIR="${CONFIG_DIR}/bin"
LOG_DIR="${CONFIG_DIR}/logs"
MANIFEST_DIR="${CONFIG_DIR}/manifest"
GUARDIAN_BIN="${BIN_DIR}/guardian-watch.sh"
TMUX_SESSION="forge-night"

usage() {
  cat <<'EOF'
NightGuardian — ForgeChain SmartResume Daemon

Commands:
  install               Install NightGuardian daemon files
  start                 Start the guardian (tmux background session)
  stop                  Stop the guardian
  restart               Restart the guardian
  status                Show current guardian status + recent logs
  logs                  Tail the guardian log file
  simulate              Simulate a rate-limit detection (test mode)
  notify <slack|none>   Configure notification method
  checkpoint <interval> Set checkpoint auto-save interval (e.g. 5min)
  autostart <on|off|status>  로그인 자동시작(LaunchAgent) 등록/해제/상태

Examples:
  nightguardian install
  nightguardian start
  nightguardian status
  nightguardian simulate
EOF
}

log_info()  { echo -e "\033[34m[INFO]\033[0m $*"; }
log_ok()    { echo -e "\033[32m[OK]\033[0m   $*"; }
log_warn()  { echo -e "\033[33m[WARN]\033[0m $*"; }
log_error() { echo -e "\033[31m[ERR]\033[0m  $*"; }

# ───────────────────────────────────────────────────────────────
cmd_install() {
  log_info "Installing NightGuardian to ${CONFIG_DIR}..."
  mkdir -p "${CONFIG_DIR}/"{bin,config,manifest,logs}

  if [ ! -x "$GUARDIAN_BIN" ]; then
    log_error "guardian-watch.sh not found at ${GUARDIAN_BIN}."
    log_info "Please ensure the NightGuardian distribution files are in place."
    exit 1
  fi

  chmod +x "${BIN_DIR}/"*
  ln -sf "${BIN_DIR}/nightguardian" "${HOME}/.local/bin/nightguardian" 2>/dev/null || true

  log_ok "NightGuardian installed."
  log_info "Config file: ${CONFIG_DIR}/config/sessions.json"
  log_info "Run 'nightguardian start' to launch the daemon."
}

# ───────────────────────────────────────────────────────────────
cmd_start() {
  if ! tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    log_info "Starting NightGuardian in tmux session '${TMUX_SESSION}'..."
    tmux new-session -d -s "$TMUX_SESSION" -n guardian bash -c "
      trap 'echo \"NightGuardian shutting down...\" >> ${LOG_DIR}/guardian.log; exit 0' INT TERM
      cd ${CONFIG_DIR}
      exec ${GUARDIAN_BIN}
    "
    sleep 1
    if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
      log_ok "NightGuardian running in tmux session '${TMUX_SESSION}'"
      log_info "Attach: tmux attach -t ${TMUX_SESSION}"
      log_info "Status: nightguardian status"
    else
      log_error "Failed to start tmux session."
      exit 1
    fi
  else
    log_warn "NightGuardian is already running in tmux session '${TMUX_SESSION}'."
  fi
}

# ───────────────────────────────────────────────────────────────
cmd_stop() {
  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    log_info "Stopping NightGuardian..."
    tmux send-keys -t "$TMUX_SESSION" C-c 2>/dev/null || true
    sleep 1
    tmux kill-session -t "$TMUX_SESSION" 2>/dev/null || true
    log_ok "NightGuardian stopped."
  else
    log_warn "NightGuardian is not running."
  fi
}

# ───────────────────────────────────────────────────────────────
cmd_restart() {
  cmd_stop 2>/dev/null || true
  sleep 1
  cmd_start
}

# ───────────────────────────────────────────────────────────────
cmd_status() {
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "🌙 NightGuardian Status Report"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    echo -e "\n  Daemon status:   \033[32mRUNNING\033[0m"
    echo "  tmux session:    ${TMUX_SESSION}"
    echo "  PID:             $(pgrep -f guardian-watch.sh 2>/dev/null || echo N/A)"
  else
    echo -e "\n  Daemon status:   \033[31mSTOPPED\033[0m"
  fi

  echo "  Config dir:      ${CONFIG_DIR}"
  echo "  Sessions config: ${CONFIG_DIR}/config/sessions.json"
  echo "  Log file:        ${LOG_DIR}/guardian.log"

  # Active rate-limited sessions
  local waiting_count
  waiting_count=$(find "$MANIFEST_DIR" -name 'session_*.state' 2>/dev/null | wc -l | tr -d ' ')
  echo "  Waiting sessions: ${waiting_count}"

  if [ "$waiting_count" -gt 0 ]; then
    echo "  ──────────────────────────────────────────────────────────"
    for f in "$MANIFEST_DIR"/session_*.state; do
      [ -f "$f" ] || continue
      local sess reset_epoch phase
      sess=$(basename "$f" .state | sed 's/session_//')
      phase=$(sed -n '1p' "$f")
      reset_epoch=$(sed -n '2p' "$f")
      local human_reset
      human_reset=$(TZ=Asia/Seoul date -r "$reset_epoch" '+%H:%M %Z' 2>/dev/null || date -d "@$reset_epoch" '+%H:%M %Z' 2>/dev/null || echo "epoch:$reset_epoch")
      echo "    📵 ${sess}: waiting until ${human_reset}"
    done
  fi

  # Recent log tail
  echo "  ──────────────────────────────────────────────────────────"
  echo "  Recent log (last 15 lines):"
  if [ -f "${LOG_DIR}/guardian.log" ]; then
    tail -n 15 "${LOG_DIR}/guardian.log" | sed 's/^/    /'
  else
    echo "    (no logs yet)"
  fi
  echo ""
}

# ───────────────────────────────────────────────────────────────
cmd_logs() {
  if [ -f "${LOG_DIR}/guardian.log" ]; then
    tail -f "${LOG_DIR}/guardian.log"
  else
    log_warn "No log file found. Start Guardian first: nightguardian start"
  fi
}

# ───────────────────────────────────────────────────────────────
cmd_simulate() {
  log_info "Simulating rate-limit scenario..."
  local test_session="nightguardian-test"

  # Create a fake tmux session for testing
  if tmux has-session -t "$test_session" 2>/dev/null; then
    tmux kill-session -t "$test_session" 2>/dev/null || true
  fi

  log_info "Creating test tmux session..."
  tmux new-session -d -s "$test_session"

  # Inject a fake rate-limit message into the test session
  # We create a pane that looks like it hit a rate limit, resetting ~2 min from now
  local future_time
  future_time=$(TZ=Asia/Seoul date -v+2M '+%I:%M%p' 2>/dev/null || TZ=Asia/Seoul date -d '+2 minutes' '+%I:%M%p' 2>/dev/null || echo "unknown")
  local future_time_spaced
  future_time_spaced=$(echo "$future_time" | sed -E 's/([0-9]{1,2}:[0-9]{2})([ap]m)/\1 \2/')

  log_info "Injecting fake rate-limit message (reset at ${future_time_spaced})..."
  tmux send-keys -t "$test_session" "echo 'Simulation: You have hit your session limit. Resets ${future_time_spaced} (Asia/Seoul). Rate limit options: 1. Stop and wait...'" C-m
  sleep 0.5
  tmux send-keys -t "$test_session" "echo 'NightGuardian test injection complete.'" C-m

  # Wait for the daemon to pick it up
  log_info "Waiting for NightGuardian to detect (30s)..."
  sleep 35

  # Check if state file was created
  local state_file="${MANIFEST_DIR}/session_${test_session}.state"
  if [ -f "$state_file" ]; then
    log_ok "DETECTION WORKS! State file created."
    echo "  State file: $(cat "$state_file")"
  else
    log_error "Detection did NOT work. Check guardian is running."
  fi

  # Countdown to simulated reset
  log_info "Waiting for simulated reset time (${future_time_spaced})..."
  local reset_epoch
  reset_epoch=$(TZ=Asia/Seoul date -j -f "%I:%M %p" "${future_time_spaced}" "+%s" 2>/dev/null || TZ=Asia/Seoul date -d "${future_time_spaced}" "+%s" 2>/dev/null || echo "")
  if [ -n "$reset_epoch" ]; then
    local now
    now=$(date +%s)
    while [ "$now" -lt "$((reset_epoch + 60))" ]; do
      now=$(date +%s)
      local rem=$((reset_epoch + 60 - now))
      if [ "$rem" -le 0 ]; then break; fi
      echo -ne "  \r  Countdown: ${rem}s remaining... "
      sleep 5
    done
    echo ""
  else
    sleep 130  # fallback: 2m + 10s buffer
  fi

  # Verify resume
  if [ -f "$state_file" ]; then
    log_error "State file still exists — resume may not have fired. Check logs."
  else
    log_ok "RESUME TRIGGERED! NightGuardian sent the resume prompt."
  fi

  # Cleanup
  log_info "Cleaning up test session..."
  tmux kill-session -t "$test_session" 2>/dev/null || true
  log_ok "Simulation complete."
}

# ───────────────────────────────────────────────────────────────
cmd_autostart() {
  local action="${1:-on}"
  local label="com.voidlight.nightguardian"
  local plist_dst="${HOME}/Library/LaunchAgents/${label}.plist"
  local plist_src="${CONFIG_DIR}/config/${label}.plist"
  local uid; uid="$(id -u)"

  case "$action" in
    on|install|enable)
      if [ ! -f "$plist_src" ]; then
        log_error "plist 템플릿 없음: ${plist_src}"
        exit 1
      fi
      mkdir -p "${HOME}/Library/LaunchAgents"
      # HOME_PLACEHOLDER → 실제 HOME 치환하여 설치
      sed "s#HOME_PLACEHOLDER#${HOME}#g" "$plist_src" > "$plist_dst"
      log_info "LaunchAgent 설치: ${plist_dst}"
      # 기존 등록 제거 후 재등록(멱등)
      launchctl bootout "gui/${uid}/${label}" 2>/dev/null || true
      if launchctl bootstrap "gui/${uid}" "$plist_dst" 2>/dev/null; then
        log_ok "자동시작 등록됨 (로그인 시 + 60초마다 생존 점검)."
      else
        # 구형 폴백
        launchctl load -w "$plist_dst" 2>/dev/null || true
        log_ok "자동시작 등록됨 (load -w 폴백)."
      fi
      launchctl kickstart "gui/${uid}/${label}" 2>/dev/null || true
      ;;
    off|uninstall|disable)
      launchctl bootout "gui/${uid}/${label}" 2>/dev/null || launchctl unload -w "$plist_dst" 2>/dev/null || true
      rm -f "$plist_dst"
      log_ok "자동시작 해제됨 (데몬은 계속 실행 중. 중지하려면 'nightguardian stop')."
      ;;
    status)
      if launchctl print "gui/${uid}/${label}" >/dev/null 2>&1; then
        log_ok "자동시작 등록 상태: ON"
      else
        log_warn "자동시작 등록 상태: OFF"
      fi
      ;;
    *)
      log_error "Unknown autostart action: ${action} (on|off|status)"
      exit 1
      ;;
  esac
}

# ───────────────────────────────────────────────────────────────
cmd_notify() {
  local method="${1:-none}"
  log_info "Notification method set to: ${method}"
  echo "$method" > "${CONFIG_DIR}/config/notify.conf"
  log_ok "Config saved."
}

# ───────────────────────────────────────────────────────────────
cmd_checkpoint() {
  local interval="${1:-5min}"
  log_info "Checkpoint auto-save interval set to: ${interval}"
  echo "$interval" > "${CONFIG_DIR}/config/checkpoint.conf"
  log_ok "Config saved."
}

# ═══════════════════════════════════════════════════════════════
# Main entry
# ═══════════════════════════════════════════════════════════════

command="${1:-}"
shift 2>/dev/null || true

case "$command" in
  install|deploy)        cmd_install ;;
  start)                 cmd_start ;;
  stop)                  cmd_stop ;;
  restart)               cmd_restart ;;
  status)                cmd_status ;;
  logs)                  cmd_logs ;;
  simulate)              cmd_simulate ;;
  notify)                cmd_notify "$@" ;;
  checkpoint)            cmd_checkpoint "$@" ;;
  autostart)             cmd_autostart "$@" ;;
  --help|-h|help|"")     usage ;;
  *)
    log_error "Unknown command: $command"
    usage
    exit 1
    ;;
esac
